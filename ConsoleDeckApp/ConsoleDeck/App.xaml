<Application x:Class="ConsoleDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark"/>
        <ui:ControlsDictionary/>
      </ResourceDictionary.MergedDictionaries>

      <tb:TaskbarIcon x:Key="TrayIcon"
                      IconSource="/Assets/ConsoleDeck.ico"
                      ToolTipText="ConsoleDeck"
                      TrayMouseDoubleClick="TrayIcon_DoubleClick">
        <tb:TaskbarIcon.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Öffnen" Click="TrayOpen_Click" FontWeight="SemiBold"/>
            <Separator/>
            <MenuItem Header="Beenden" Click="TrayQuit_Click"/>
          </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
      </tb:TaskbarIcon>
    </ResourceDictionary>
  </Application.Resources>

</Application>
