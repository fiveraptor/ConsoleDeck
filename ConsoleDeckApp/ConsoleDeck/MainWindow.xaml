<Window x:Class="ConsoleDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ConsoleDeck" Width="980" Height="720"
        MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrPageBg}"
        Closing="Window_Closing">

  <Window.Resources>
    <Style x:Key="SidebarIconBtn" TargetType="Button">
      <Setter Property="Width"  Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Width="26" Height="26">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource BrTextSecondary}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A808080"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A808080"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- NavItem: triggers use Style.Triggers so DynamicResource works correctly -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrNavHoverBg}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrNavSelectedBg}"/>
          <Setter Property="Foreground" Value="{DynamicResource BrNavSelectedFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Grid Grid.Column="0" Background="{DynamicResource BrSidebarBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Branding -->
      <Border Grid.Row="0" Padding="18,22,18,16"
              BorderBrush="{DynamicResource BrDivider}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
          <Image Source="/Assets/ConsoleDeck.ico" Width="22" Height="22"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="0,0,12,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ConsoleDeck" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrTextPrimary}"/>
            <TextBlock Text="Macro Deck" FontSize="11"
                       Foreground="{DynamicResource BrTextSecondary}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Profile selector -->
      <Border Grid.Row="1" Padding="10,7"
              BorderBrush="{DynamicResource BrDivider}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="ProfileCombo" Grid.Column="0"
                    FontSize="12" Height="30" Padding="8,4"
                    Margin="0,0,4,0"
                    SelectionChanged="ProfileCombo_SelectionChanged"/>
          <Button Grid.Column="1" Content="+" Style="{StaticResource SidebarIconBtn}"
                  ToolTip="Neues Profil" Click="BtnAddProfile_Click"/>
          <Button Grid.Column="2" Content="✎" Style="{StaticResource SidebarIconBtn}"
                  ToolTip="Umbenennen" Click="BtnRenameProfile_Click"/>
          <Button x:Name="BtnDeleteProfile" Grid.Column="3" Content="✕"
                  Style="{StaticResource SidebarIconBtn}"
                  ToolTip="Löschen" Click="BtnDeleteProfile_Click"/>
        </Grid>
      </Border>

      <!-- Nav -->
      <ListBox x:Name="NavList" Grid.Row="2" Background="Transparent" BorderThickness="0"
               Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="False"
               SelectionChanged="NavList_SelectionChanged"
               ItemContainerStyle="{StaticResource NavItem}">
        <ListBoxItem Tag="dashboard">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Grid24" FontSize="16" Margin="0,0,11,0" VerticalAlignment="Center"/>
            <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="settings">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,11,0" VerticalAlignment="Center"/>
            <TextBlock Text="Einstellungen" VerticalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </ListBoxItem>
      </ListBox>

      <!-- Connection status -->
      <Border Grid.Row="3" Padding="16,14"
              BorderBrush="{DynamicResource BrDivider}" BorderThickness="0,1,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Ellipse x:Name="ArduinoLed" Width="7" Height="7"
                     Fill="{DynamicResource BrTextHint}"
                     Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ArduinoStatus" Text="Arduino: Suche…"
                       Foreground="{DynamicResource BrTextSecondary}"
                       FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="DiscordLed" Width="7" Height="7"
                     Fill="{DynamicResource BrTextHint}"
                     Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="DiscordStatusBar" Text="Discord: Getrennt"
                       Foreground="{DynamicResource BrTextSecondary}"
                       FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Sidebar divider -->
    <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1"
               Fill="{DynamicResource BrDivider}" IsHitTestVisible="False"/>

    <!-- Content -->
    <Frame x:Name="ContentFrame" Grid.Column="1"
           NavigationUIVisibility="Hidden" Background="Transparent">
      <Frame.RenderTransform><TranslateTransform/></Frame.RenderTransform>
    </Frame>

    <!-- Toast notification -->
    <Border x:Name="ToastBorder"
            Grid.Column="0" Grid.ColumnSpan="2"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="{DynamicResource BrToastBg}" CornerRadius="6" Padding="18,11"
            Margin="0,0,0,28" Visibility="Collapsed" Opacity="0" Panel.ZIndex="100">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14"
                       Foreground="{DynamicResource BrToastFg}"
                       Margin="0,0,9,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource BrToastFg}" FontSize="13"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
