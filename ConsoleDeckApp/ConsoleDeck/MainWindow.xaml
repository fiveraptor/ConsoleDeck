<Window x:Class="ConsoleDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ConsoleDeck" Width="780" Height="600"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Closing="Window_Closing">

  <Window.Resources>
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="4,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                <Setter Property="Foreground" Value="#DDDDDD"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="#1A1A1A"
              BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- App header -->
          <Border DockPanel.Dock="Top" Padding="18,16,18,10">
            <StackPanel Orientation="Horizontal">
              <Image Source="/Assets/ConsoleDeck.ico" Width="22" Height="22" Margin="0,0,10,0"
                     VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Text="ConsoleDeck" FontSize="15" FontWeight="SemiBold"
                         Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Nav items -->
          <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                   Margin="6,4" SelectionChanged="NavList_SelectionChanged"
                   ItemContainerStyle="{StaticResource NavItemStyle}">
            <ListBoxItem Tag="dashboard">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Grid24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13"/>
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem Tag="settings">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Einstellungen" VerticalAlignment="Center" FontSize="13"/>
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Content frame -->
      <Frame x:Name="ContentFrame" Grid.Column="1"
             NavigationUIVisibility="Hidden" Background="#141414"/>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Background="#111111" Padding="16,6">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="ArduinoLed" Width="8" Height="8" Fill="#555555"
                 Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ArduinoStatus" Text="Arduino: Suche..." Foreground="#888888"
                   FontSize="11" VerticalAlignment="Center"/>
        <Rectangle Width="1" Fill="#333333" Margin="16,0" Height="14"/>
        <Ellipse x:Name="DiscordLed" Width="8" Height="8" Fill="#555555"
                 Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="DiscordStatusBar" Text="Discord: Nicht verbunden"
                   Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Toast notification -->
    <Border x:Name="ToastBorder" Grid.Row="0" Grid.RowSpan="2"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#1F3A5F" CornerRadius="6" Padding="16,8"
            Margin="0,0,0,20" Visibility="Collapsed" Panel.ZIndex="100">
      <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
    </Border>
  </Grid>
</Window>
