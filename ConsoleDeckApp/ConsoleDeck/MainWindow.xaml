<Window x:Class="ConsoleDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ConsoleDeck" Width="980" Height="720"
        MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrPageBg}"
        Closing="Window_Closing">

  <Window.Resources>
    <!-- NavItem: triggers use Style.Triggers so DynamicResource works correctly -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrNavHoverBg}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrNavSelectedBg}"/>
          <Setter Property="Foreground" Value="{DynamicResource BrNavSelectedFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Grid Grid.Column="0" Background="{DynamicResource BrSidebarBg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Branding -->
      <Border Grid.Row="0" Padding="18,22,18,16"
              BorderBrush="{DynamicResource BrDivider}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
          <Image Source="/Assets/ConsoleDeck.ico" Width="22" Height="22"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="0,0,12,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ConsoleDeck" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrTextPrimary}"/>
            <TextBlock Text="Macro Deck" FontSize="11"
                       Foreground="{DynamicResource BrTextSecondary}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Nav -->
      <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0"
               Margin="0,8,0,0" VirtualizingPanel.IsVirtualizing="False"
               SelectionChanged="NavList_SelectionChanged"
               ItemContainerStyle="{StaticResource NavItem}">
        <ListBoxItem Tag="dashboard">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Grid24" FontSize="16" Margin="0,0,11,0" VerticalAlignment="Center"/>
            <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="settings">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,11,0" VerticalAlignment="Center"/>
            <TextBlock Text="Einstellungen" VerticalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </ListBoxItem>
      </ListBox>

      <!-- Connection status -->
      <Border Grid.Row="2" Padding="16,14"
              BorderBrush="{DynamicResource BrDivider}" BorderThickness="0,1,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Ellipse x:Name="ArduinoLed" Width="7" Height="7"
                     Fill="{DynamicResource BrTextHint}"
                     Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ArduinoStatus" Text="Arduino: Suche…"
                       Foreground="{DynamicResource BrTextSecondary}"
                       FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="DiscordLed" Width="7" Height="7"
                     Fill="{DynamicResource BrTextHint}"
                     Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="DiscordStatusBar" Text="Discord: Getrennt"
                       Foreground="{DynamicResource BrTextSecondary}"
                       FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Sidebar divider -->
    <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1"
               Fill="{DynamicResource BrDivider}" IsHitTestVisible="False"/>

    <!-- Content -->
    <Frame x:Name="ContentFrame" Grid.Column="1"
           NavigationUIVisibility="Hidden" Background="Transparent">
      <Frame.RenderTransform><TranslateTransform/></Frame.RenderTransform>
    </Frame>

    <!-- Toast notification -->
    <Border x:Name="ToastBorder"
            Grid.Column="0" Grid.ColumnSpan="2"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="{DynamicResource BrToastBg}" CornerRadius="6" Padding="18,11"
            Margin="0,0,0,28" Visibility="Collapsed" Opacity="0" Panel.ZIndex="100">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14"
                       Foreground="{DynamicResource BrToastFg}"
                       Margin="0,0,9,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource BrToastFg}" FontSize="13"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
