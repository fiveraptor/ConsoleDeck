<Window x:Class="ConsoleDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ConsoleDeck" Width="980" Height="720"
        MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E11"
        Closing="Window_Closing">

  <Window.Resources>
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9090AA"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="6,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1C1C24"/>
                <Setter Property="Foreground" Value="#C0C0D8"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#192840"/>
                <Setter Property="Foreground" Value="#7AAAFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ══ Sidebar ══ -->
    <Grid Grid.Column="0" Background="#131318">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Branding -->
      <Border Grid.Row="0" Padding="18,22,18,16"
              BorderBrush="#1E1E28" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal">
          <Border Background="#1A2B45" CornerRadius="9" Padding="7"
                  Margin="0,0,12,0" VerticalAlignment="Center">
            <Image Source="/Assets/ConsoleDeck.ico" Width="20" Height="20"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ConsoleDeck" FontSize="14" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Macro Deck" FontSize="11" Foreground="#606075"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Nav -->
      <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0"
               Margin="0,10,0,0" VirtualizingPanel.IsVirtualizing="False"
               SelectionChanged="NavList_SelectionChanged"
               ItemContainerStyle="{StaticResource NavItem}">
        <ListBoxItem Tag="dashboard">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Grid24" FontSize="16" Margin="0,0,11,0" VerticalAlignment="Center"/>
            <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem Tag="settings">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,11,0" VerticalAlignment="Center"/>
            <TextBlock Text="Einstellungen" VerticalAlignment="Center" FontSize="13"/>
          </StackPanel>
        </ListBoxItem>
      </ListBox>

      <!-- Connection status -->
      <Border Grid.Row="2" Padding="16,14" BorderBrush="#1E1E28" BorderThickness="0,1,0,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Ellipse x:Name="ArduinoLed" Width="7" Height="7" Fill="#505060"
                     Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ArduinoStatus" Text="Arduino: Suche…"
                       Foreground="#707080" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="DiscordLed" Width="7" Height="7" Fill="#505060"
                     Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="DiscordStatusBar" Text="Discord: Getrennt"
                       Foreground="#707080" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Sidebar border -->
    <Rectangle Grid.Column="0" HorizontalAlignment="Right" Width="1"
               Fill="#1E1E28" IsHitTestVisible="False"/>

    <!-- Content -->
    <Frame x:Name="ContentFrame" Grid.Column="1"
           NavigationUIVisibility="Hidden" Background="Transparent"/>

    <!-- Toast -->
    <Border x:Name="ToastBorder"
            Grid.Column="0" Grid.ColumnSpan="2"
            VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#192840" CornerRadius="10" Padding="18,11"
            Margin="0,0,0,28" Visibility="Collapsed" Panel.ZIndex="100">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="#7AAAFF"
                       Margin="0,0,9,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
