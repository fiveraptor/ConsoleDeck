<Page x:Class="ConsoleDeck.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:h="clr-namespace:ConsoleDeck.Helpers"
      Background="Transparent"
      Title="Einstellungen">

  <Page.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background"       Value="{DynamicResource BrCardBg}"/>
      <Setter Property="CornerRadius"     Value="8"/>
      <Setter Property="Padding"          Value="24"/>
      <Setter Property="Margin"           Value="0,0,0,12"/>
      <Setter Property="BorderBrush"      Value="{DynamicResource BrCardBorder}"/>
      <Setter Property="BorderThickness"  Value="1"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize"   Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource BrTextPrimary}"/>
      <Setter Property="FontSize"   Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin"     Value="0,0,0,5"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground"    Value="{DynamicResource BrTextSecondary}"/>
      <Setter Property="FontSize"      Value="12"/>
      <Setter Property="TextWrapping"  Value="Wrap"/>
      <Setter Property="Margin"        Value="0,0,0,16"/>
    </Style>
    <Style x:Key="Input" TargetType="ui:TextBox">
      <Setter Property="Background"     Value="{DynamicResource BrInputBg}"/>
      <Setter Property="Foreground"     Value="{DynamicResource BrTextPrimary}"/>
      <Setter Property="BorderBrush"    Value="{DynamicResource BrInputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"        Value="10,7"/>
      <Setter Property="FontSize"       Value="13"/>
      <Setter Property="CaretBrush"     Value="{DynamicResource BrTextPrimary}"/>
      <Setter Property="Margin"         Value="0,0,0,14"/>
    </Style>
    <Style x:Key="PassInput" TargetType="PasswordBox">
      <Setter Property="Background"     Value="{DynamicResource BrInputBg}"/>
      <Setter Property="Foreground"     Value="{DynamicResource BrTextPrimary}"/>
      <Setter Property="BorderBrush"    Value="{DynamicResource BrInputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"        Value="10,7"/>
      <Setter Property="FontSize"       Value="13"/>
      <Setter Property="Margin"         Value="0,0,0,14"/>
    </Style>

    <!-- AccentBtn: hover instant, press = scale 0.97 -->
    <Style x:Key="AccentBtn" TargetType="Button">
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding"     Value="18,8"/>
      <Setter Property="FontSize"    Value="13"/>
      <Setter Property="FontWeight"  Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#0078D4" CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="White"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#006CBD"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#005BA1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.97" Duration="0:0:0.05"/>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.97" Duration="0:0:0.05"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1" Duration="0:0:0.1"/>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1" Duration="0:0:0.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- GhostBtn: overlay hover (works on light AND dark), press = scale 0.97 -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Cursor"     Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding"    Value="18,8"/>
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource BrGhostBg}"
                    BorderBrush="{DynamicResource BrGhostBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{DynamicResource BrTextPrimary}"
                                TextElement.FontSize="{TemplateBinding FontSize}"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- #1A808080 = 10% gray — darkens white, brightens dark bg -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"  Value="#1A808080"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#8C8C8C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background"  Value="#2A808080"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#8C8C8C"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.97" Duration="0:0:0.05"/>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="0.97" Duration="0:0:0.05"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1" Duration="0:0:0.1"/>
                      <DoubleAnimation Storyboard.TargetName="Bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1" Duration="0:0:0.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toggle switch with slide + color animation -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
      <Setter Property="Width"  Value="44"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="44" Height="24">
              <Border x:Name="Track" CornerRadius="12">
                <Border.Background><SolidColorBrush Color="#ABABAB"/></Border.Background>
              </Border>
              <Canvas>
                <Ellipse x:Name="Thumb" Width="18" Height="18"
                         Fill="#FFFFFF" Canvas.Top="3" Canvas.Left="3"/>
              </Canvas>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Track"
                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                      To="#0078D4" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="Thumb"
                                       Storyboard.TargetProperty="(Canvas.Left)"
                                       To="23" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="Track"
                                      Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                      To="#ABABAB" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="Thumb"
                                       Storyboard.TargetProperty="(Canvas.Left)"
                                       To="3" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" h:SmoothScroll.Enabled="True">
    <StackPanel Margin="30,26,30,24">

      <!-- Page title -->
      <StackPanel Margin="0,0,0,22">
        <TextBlock Text="Einstellungen" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrTextPrimary}"/>
        <TextBlock Text="Dienste konfigurieren" FontSize="12"
                   Foreground="{DynamicResource BrTextSecondary}" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- App -->
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardTitle}" Text="Autostart"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                       Text="ConsoleDeck automatisch mit Windows starten — startet still im Hintergrund, kein Fenster."/>
          </StackPanel>
          <ToggleButton x:Name="AutostartToggle" Grid.Column="1"
                        Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        Checked="AutostartToggle_Changed" Unchecked="AutostartToggle_Changed"/>
        </Grid>
      </Border>

      <!-- Discord -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Discord Integration"/>
            <Border x:Name="DiscordStatusBadge" Grid.Column="1" CornerRadius="4" Padding="10,4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BrPageBg}"
                    BorderBrush="{DynamicResource BrCardBorder}" BorderThickness="1">
              <TextBlock x:Name="DiscordStatusText" Text="Nicht verbunden" FontSize="11"
                         Foreground="{DynamicResource BrTextSecondary}"/>
            </Border>
          </Grid>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID"/>
          <ui:TextBox x:Name="TbDiscordId" Style="{StaticResource Input}"
                      PlaceholderText="Discord Application Client ID"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Client Secret"/>
          <PasswordBox x:Name="PbDiscordSecret" Style="{StaticResource PassInput}"/>

          <TextBlock Style="{StaticResource Hint}"
                     Text="Client ID und Secret unter discord.com/developers/applications → deine App → OAuth2.&#x0a;Redirect URI eintragen: http://localhost&#x0a;Nach dem Speichern erscheint ein Autorisierungs-Popup in Discord — bestätigen."/>

          <Button Content="Speichern" Style="{StaticResource AccentBtn}"
                  HorizontalAlignment="Right" Click="SaveDiscord_Click"/>
        </StackPanel>
      </Border>

      <!-- Home Assistant -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Home Assistant" Margin="0,0,0,20"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="URL"/>
          <ui:TextBox x:Name="TbHaUrl" Style="{StaticResource Input}"
                      PlaceholderText="http://homeassistant.local:8123"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Long-Lived Access Token"/>
          <PasswordBox x:Name="PbHaToken" Style="{StaticResource PassInput}"/>

          <TextBlock Style="{StaticResource Hint}"
                     Text="Token erstellen: Home Assistant → Profil → Sicherheit → Langlebiges Zugriffstoken."/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HaTestResult" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource BrTextSecondary}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Verbindung testen" Style="{StaticResource GhostBtn}"
                      Margin="0,0,10,0" Click="TestHa_Click"/>
              <Button Content="Speichern" Style="{StaticResource AccentBtn}"
                      Click="SaveHa_Click"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
