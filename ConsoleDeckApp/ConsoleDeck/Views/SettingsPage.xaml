<Page x:Class="ConsoleDeck.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:ConsoleDeck.ViewModels"
      Title="Einstellungen">

  <Page.Resources>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="InputBox" TargetType="ui:TextBox">
      <Setter Property="Background" Value="#242424"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="PassBox" TargetType="PasswordBox">
      <Setter Property="Background" Value="#242424"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#1F3A5F"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#333333"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">

      <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold"
                 Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,20"/>

      <!-- Discord -->
      <Border Style="{StaticResource SectionCard}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Discord Integration" Style="{StaticResource SectionTitle}" Margin="0"/>
            <Border x:Name="DiscordStatusBadge" CornerRadius="4" Padding="6,2" Margin="12,0,0,0"
                    VerticalAlignment="Center" Background="#333333">
              <TextBlock x:Name="DiscordStatusText" Text="Nicht verbunden" FontSize="11" Foreground="#AAAAAA"/>
            </Border>
          </StackPanel>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID"/>
          <ui:TextBox x:Name="TbDiscordId" Style="{StaticResource InputBox}" PlaceholderText="Discord Application Client ID"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Client Secret"/>
          <PasswordBox x:Name="PbDiscordSecret" Style="{StaticResource PassBox}"/>

          <TextBlock Text="Client ID und Secret: discord.com/developers/applications → deine App → OAuth2" FontSize="11" Foreground="#666666" Margin="0,0,0,8" TextWrapping="Wrap"/>
          <TextBlock Text="Redirect URI in der App eintragen: http://localhost" FontSize="11" Foreground="#666666" Margin="0,0,0,14" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern" Style="{StaticResource PrimaryBtn}" Click="SaveDiscord_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Home Assistant -->
      <Border Style="{StaticResource SectionCard}">
        <StackPanel>
          <TextBlock Text="Home Assistant" Style="{StaticResource SectionTitle}"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="URL"/>
          <ui:TextBox x:Name="TbHaUrl" Style="{StaticResource InputBox}" PlaceholderText="http://homeassistant.local:8123"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Long-Lived Access Token"/>
          <PasswordBox x:Name="PbHaToken" Style="{StaticResource PassBox}"/>

          <TextBlock Text="Token erstellen: Home Assistant → Profil (unten links) → Sicherheit → Token erstellen" FontSize="11" Foreground="#666666" Margin="0,0,0,14" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="HaTestResult" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="12" Foreground="#AAAAAA"/>
            <Button Content="Verbindung testen" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                    Click="TestHa_Click"/>
            <Button Content="Speichern" Style="{StaticResource PrimaryBtn}" Click="SaveHa_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
