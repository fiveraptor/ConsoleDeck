<Page x:Class="ConsoleDeck.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent"
      Title="Einstellungen">

  <Page.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#131318"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
      <Setter Property="BorderBrush" Value="#1E1E28"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9090A8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#707088"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="Input" TargetType="ui:TextBox">
      <Setter Property="Background" Value="#0E0E11"/>
      <Setter Property="Foreground" Value="#E0E0F0"/>
      <Setter Property="BorderBrush" Value="#2A2A38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="PassInput" TargetType="PasswordBox">
      <Setter Property="Background" Value="#0E0E11"/>
      <Setter Property="Foreground" Value="#E0E0F0"/>
      <Setter Property="BorderBrush" Value="#2A2A38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button">
      <Setter Property="Background" Value="#1E3460"/>
      <Setter Property="Foreground" Value="#7AAAFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Background" Value="#18181E"/>
      <Setter Property="Foreground" Value="#707080"/>
      <Setter Property="BorderBrush" Value="#2A2A38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="44" Height="24">
              <Border x:Name="Track" Background="#2A2A3A" CornerRadius="12"/>
              <Canvas>
                <Ellipse x:Name="Thumb" Width="18" Height="18"
                         Fill="#4A4A60" Canvas.Top="3" Canvas.Left="3"/>
              </Canvas>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#1E3460"/>
                <Setter TargetName="Thumb" Property="Fill" Value="#7AAAFF"/>
                <Setter TargetName="Thumb" Property="Canvas.Left" Value="23"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="30,26,30,24">

      <!-- Page title -->
      <StackPanel Margin="0,0,0,22">
        <TextBlock Text="Einstellungen" FontSize="22" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Dienste konfigurieren" FontSize="12" Foreground="#707088" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- ── App ── -->
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardTitle}" Text="Autostart"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,0"
                       Text="ConsoleDeck automatisch mit Windows starten — startet still im Hintergrund, kein Fenster."/>
          </StackPanel>
          <ToggleButton x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                        VerticalAlignment="Center"
                        Checked="AutostartToggle_Changed" Unchecked="AutostartToggle_Changed"/>
        </Grid>
      </Border>

      <!-- ── Discord ── -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <!-- Card header -->
          <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Discord Integration"/>
            <Border x:Name="DiscordStatusBadge" Grid.Column="1" CornerRadius="20" Padding="10,4"
                    VerticalAlignment="Center" Background="#1C1C24">
              <TextBlock x:Name="DiscordStatusText" Text="Nicht verbunden" FontSize="11" Foreground="#505060"/>
            </Border>
          </Grid>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Client ID"/>
          <ui:TextBox x:Name="TbDiscordId" Style="{StaticResource Input}"
                      PlaceholderText="Discord Application Client ID"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Client Secret"/>
          <PasswordBox x:Name="PbDiscordSecret" Style="{StaticResource PassInput}"/>

          <TextBlock Style="{StaticResource Hint}"
                     Text="Client ID und Secret unter discord.com/developers/applications → deine App → OAuth2.&#x0a;Redirect URI eintragen: http://localhost&#x0a;Nach dem Speichern erscheint ein Autorisierungs-Popup in Discord — bestätigen."/>

          <Button Content="Speichern" Style="{StaticResource AccentBtn}"
                  HorizontalAlignment="Right" Click="SaveDiscord_Click"/>
        </StackPanel>
      </Border>

      <!-- ── Home Assistant ── -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Home Assistant" Margin="0,0,0,20"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="URL"/>
          <ui:TextBox x:Name="TbHaUrl" Style="{StaticResource Input}"
                      PlaceholderText="http://homeassistant.local:8123"/>

          <TextBlock Style="{StaticResource FieldLabel}" Text="Long-Lived Access Token"/>
          <PasswordBox x:Name="PbHaToken" Style="{StaticResource PassInput}"/>

          <TextBlock Style="{StaticResource Hint}"
                     Text="Token erstellen: Home Assistant → Profil → Sicherheit → Langlebiges Zugriffstoken."/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HaTestResult" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Foreground="#505060"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="Verbindung testen" Style="{StaticResource GhostBtn}"
                      Margin="0,0,10,0" Click="TestHa_Click"/>
              <Button Content="Speichern" Style="{StaticResource AccentBtn}" Click="SaveHa_Click"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Page>
