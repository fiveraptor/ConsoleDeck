<Window x:Class="ConsoleDeck.Views.ButtonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Button konfigurieren"
        Width="620" Height="520"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="#181818"
        ResizeMode="CanResize">

  <Window.Resources>
    <Style x:Key="CategoryHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#666666"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="10,8,0,2"/>
    </Style>

    <Style x:Key="TypeRadio" TargetType="RadioButton">
      <Setter Property="Margin" Value="2,1"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Foreground" Value="#CCCCCC"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1F3A5F"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="InputBox" TargetType="ui:TextBox">
      <Setter Property="Background" Value="#242424"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Border Grid.Row="0" Background="#1E1E1E" Padding="20,14">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
    </Border>

    <!-- Content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: action type list -->
      <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6,8">
            <TextBlock Style="{StaticResource CategoryHeader}" Text="Launch"/>
            <RadioButton x:Name="RbLink"    Style="{StaticResource TypeRadio}" Content="Link (URL)" Tag="link" Checked="TypeChanged"/>
            <RadioButton x:Name="RbExe"     Style="{StaticResource TypeRadio}" Content="Datei / App" Tag="exe" Checked="TypeChanged"/>

            <TextBlock Style="{StaticResource CategoryHeader}" Text="Media"/>
            <RadioButton x:Name="RbPlay"    Style="{StaticResource TypeRadio}" Content="Play / Pause" Tag="play_pause" Checked="TypeChanged"/>
            <RadioButton x:Name="RbNext"    Style="{StaticResource TypeRadio}" Content="Nächster Titel" Tag="next_track" Checked="TypeChanged"/>
            <RadioButton x:Name="RbPrev"    Style="{StaticResource TypeRadio}" Content="Vorheriger Titel" Tag="prev_track" Checked="TypeChanged"/>
            <RadioButton x:Name="RbStop"    Style="{StaticResource TypeRadio}" Content="Stop" Tag="stop" Checked="TypeChanged"/>

            <TextBlock Style="{StaticResource CategoryHeader}" Text="System"/>
            <RadioButton x:Name="RbMute"    Style="{StaticResource TypeRadio}" Content="System Mute" Tag="mute" Checked="TypeChanged"/>
            <RadioButton x:Name="RbHotkey"  Style="{StaticResource TypeRadio}" Content="Tastenkürzel" Tag="hotkey" Checked="TypeChanged"/>

            <TextBlock Style="{StaticResource CategoryHeader}" Text="Discord"/>
            <RadioButton x:Name="RbDMute"   Style="{StaticResource TypeRadio}" Content="Mute / Unmute" Tag="discord_mute" Checked="TypeChanged"/>
            <RadioButton x:Name="RbDDeaf"   Style="{StaticResource TypeRadio}" Content="Deafen / Undeafen" Tag="discord_deafen" Checked="TypeChanged"/>
            <RadioButton x:Name="RbDLeave"  Style="{StaticResource TypeRadio}" Content="Channel verlassen" Tag="discord_leave" Checked="TypeChanged"/>

            <TextBlock Style="{StaticResource CategoryHeader}" Text="Home Assistant"/>
            <RadioButton x:Name="RbHa"      Style="{StaticResource TypeRadio}" Content="Home Assistant" Tag="homeassistant" Checked="TypeChanged"/>

            <TextBlock Style="{StaticResource CategoryHeader}" Text="Sonstiges"/>
            <RadioButton x:Name="RbNone"    Style="{StaticResource TypeRadio}" Content="Keine Aktion" Tag="none" Checked="TypeChanged" IsChecked="True"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Right: form fields -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

          <!-- Link fields -->
          <StackPanel x:Name="PanelLink" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabel}" Text="URL"/>
            <ui:TextBox x:Name="TbUrl" Style="{StaticResource InputBox}" PlaceholderText="https://"/>
          </StackPanel>

          <!-- Exe fields -->
          <StackPanel x:Name="PanelExe" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Pfad zur Datei oder Verknüpfung"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ui:TextBox x:Name="TbExePath" Style="{StaticResource InputBox}" PlaceholderText="C:\Programme\App\app.exe"/>
              <Button Grid.Column="1" Content="..." Margin="6,0,0,0" Padding="10,6"
                      Background="#333" Foreground="White" BorderBrush="#555"
                      Click="BrowseExe_Click"/>
            </Grid>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Fensterfokus-Hinweis (optional)" Margin="0,14,0,4"/>
            <TextBlock Text="Ein Wort aus dem Fenstertitel der App. Wenn das Fenster offen ist, wird es fokussiert statt eine neue Instanz zu öffnen."
                       Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ui:TextBox x:Name="TbFocus" Style="{StaticResource InputBox}" PlaceholderText="z.B. Chrome, Notepad, ..."/>
          </StackPanel>

          <!-- Hotkey fields -->
          <StackPanel x:Name="PanelHotkey" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Tastenkombination"/>
            <TextBlock Text="Format: ctrl+shift+m   oder   ctrl+alt+d" Foreground="#777777" FontSize="11" Margin="0,0,0,6"/>
            <TextBlock Text="Modifier: ctrl, shift, alt, win — Tasten: F1–F12, Buchstaben, Zahlen, Sondertasten" Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ui:TextBox x:Name="TbHotkey" Style="{StaticResource InputBox}" PlaceholderText="ctrl+shift+m"/>
          </StackPanel>

          <!-- Home Assistant fields -->
          <StackPanel x:Name="PanelHa" Visibility="Collapsed">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Entity ID"/>
            <TextBlock Text="Home Assistant → Einstellungen → Geräte &amp; Dienste → Entity-ID" Foreground="#777777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <ui:TextBox x:Name="TbEntityId" Style="{StaticResource InputBox}" PlaceholderText="light.wohnzimmer"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Aktion" Margin="0,14,0,4"/>
            <ComboBox x:Name="CbHaAction" Background="#242424" Foreground="#EEEEEE"
                      BorderBrush="#444444" FontSize="13" Padding="8,6">
              <ComboBoxItem Content="toggle" IsSelected="True"/>
              <ComboBoxItem Content="turn_on"/>
              <ComboBoxItem Content="turn_off"/>
            </ComboBox>
          </StackPanel>

          <!-- No-input types (media, discord, mute, none) -->
          <StackPanel x:Name="PanelNoInput" Visibility="Collapsed">
            <TextBlock x:Name="TbNoInputHint" Foreground="#777777" FontSize="13"
                       TextWrapping="Wrap"/>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Background="#1E1E1E" Padding="20,12">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnSave" Content="Speichern" Width="110" Height="34"
                  Background="#1F3A5F" Foreground="White" BorderThickness="0"
                  FontSize="13" Margin="0,0,10,0" Click="Save_Click"/>
          <Button Content="Abbrechen" Width="100" Height="34"
                  Background="#333333" Foreground="White" BorderThickness="0"
                  FontSize="13" Click="Cancel_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
