<Page x:Class="ConsoleDeck.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:ConsoleDeck.ViewModels"
      Background="Transparent"
      Title="Dashboard">

  <Page.Resources>
    <Style x:Key="CardBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <!-- Base card (theme-aware via DynamicResource) -->
              <Border x:Name="Base" Background="{DynamicResource BrCardBg}"
                      BorderBrush="{DynamicResource BrCardBorder}"
                      BorderThickness="1" CornerRadius="8">
                <Grid>
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  <!-- Edit hint strip — fades in on hover -->
                  <Border x:Name="EditHint" CornerRadius="0,0,8,8"
                          Background="#F0F6FF" VerticalAlignment="Bottom"
                          Padding="0,7" Opacity="0" IsHitTestVisible="False">
                    <TextBlock Text="✎  bearbeiten" FontSize="11" Foreground="#0078D4"
                               HorizontalAlignment="Center" FontWeight="Medium"/>
                  </Border>
                </Grid>
              </Border>
              <!-- Hover ring: accent border fades in; sits above Base -->
              <Border x:Name="HoverRing" CornerRadius="8" BorderThickness="2"
                      BorderBrush="#0078D4" Background="#080060EE"
                      Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverRing"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.15"/>
                      <DoubleAnimation Storyboard.TargetName="EditHint"
                                       Storyboard.TargetProperty="Opacity"
                                       To="1" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverRing"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="EditHint"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverRing" Property="BorderBrush" Value="#005BA1"/>
                <Setter TargetName="HoverRing" Property="Background"  Value="#120060EE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="30,26,30,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="18"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold"
                 Foreground="{DynamicResource BrTextPrimary}"/>
      <TextBlock Text="9 konfigurierbare Tasten — klicken zum Bearbeiten"
                 FontSize="12" Foreground="{DynamicResource BrTextSecondary}" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Button grid -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Buttons}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" Rows="3"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:ButtonViewModel}">
          <Button Style="{StaticResource CardBtn}"
                  Margin="6" MinHeight="126"
                  Click="ButtonCard_Click"
                  Tag="{Binding Number}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         Text="{Binding Number, StringFormat='B{0}'}"
                         FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrTextHint}"
                         Margin="14,10,0,0" VerticalAlignment="Top"/>

              <Border Grid.Row="1" Background="{Binding TypeBrush}" CornerRadius="4"
                      Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="12,0">
                <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold"
                           Foreground="White"/>
              </Border>

              <TextBlock Grid.Row="2"
                         Text="{Binding Preview}"
                         FontSize="11" Foreground="{DynamicResource BrTextSecondary}"
                         TextTrimming="CharacterEllipsis"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         MaxWidth="170"
                         Margin="12,6,12,0"/>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Footer -->
    <TextBlock Grid.Row="3" Margin="6,14,0,0"
               Text="⌨  Media-Taste (physisch) → immer Play/Pause, nicht konfigurierbar"
               FontSize="11" Foreground="{DynamicResource BrTextHint}"/>
  </Grid>
</Page>
