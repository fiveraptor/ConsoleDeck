<Page x:Class="ConsoleDeck.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:ConsoleDeck.ViewModels"
      Background="Transparent"
      Title="Dashboard">

  <Page.Resources>
    <Style x:Key="CardBtn" TargetType="Button">
      <Setter Property="Background" Value="#18181E"/>
      <Setter Property="BorderBrush" Value="#24242E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12">
              <Grid>
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <!-- Edit hint shown on hover -->
                <Border x:Name="EditHint" CornerRadius="0,0,12,12"
                        Background="#0E0E1A" VerticalAlignment="Bottom"
                        Padding="0,8" Opacity="0">
                  <TextBlock Text="✎  bearbeiten" FontSize="11" Foreground="#4A80F0"
                             HorizontalAlignment="Center" FontWeight="Medium"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1D1D25"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A80F0"/>
                <Setter TargetName="EditHint" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16161E"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A70E0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid Margin="30,26,30,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="18"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="9 konfigurierbare Tasten — klicken zum Bearbeiten"
                 FontSize="12" Foreground="#707080" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Button grid -->
    <ItemsControl Grid.Row="2" ItemsSource="{Binding Buttons}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" Rows="3"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:ButtonViewModel}">
          <Button Style="{StaticResource CardBtn}"
                  Margin="6"
                  MinHeight="126"
                  Click="ButtonCard_Click"
                  Tag="{Binding Number}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
              </Grid.RowDefinitions>

              <!-- Button number -->
              <TextBlock Grid.Row="0"
                         Text="{Binding Number, StringFormat='B{0}'}"
                         FontSize="10" FontWeight="Bold" Foreground="#606070"
                         Margin="14,10,0,0" VerticalAlignment="Top"/>

              <!-- Type badge -->
              <Border Grid.Row="1" Background="{Binding TypeBrush}" CornerRadius="6"
                      Padding="12,5" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="12,0">
                <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="Bold"
                           Foreground="White"/>
              </Border>

              <!-- Preview text -->
              <TextBlock Grid.Row="2"
                         Text="{Binding Preview}"
                         FontSize="11" Foreground="#8888A0"
                         TextTrimming="CharacterEllipsis"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         MaxWidth="170"
                         Margin="12,6,12,0"/>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Footer note -->
    <TextBlock Grid.Row="3" Margin="6,14,0,0"
               Text="⌨  Media-Taste (physisch) → immer Play/Pause, nicht konfigurierbar"
               FontSize="11" Foreground="#606070"/>
  </Grid>
</Page>
