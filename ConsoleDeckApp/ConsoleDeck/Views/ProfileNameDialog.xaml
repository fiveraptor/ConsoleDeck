<Window x:Class="ConsoleDeck.Views.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Profile" Width="310" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrPageBg}"
        ShowInTaskbar="False">
  <Grid Margin="20,18,20,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Grid.Row="0"
               FontSize="14" FontWeight="SemiBold"
               Foreground="{DynamicResource BrTextPrimary}"/>

    <ui:TextBox x:Name="TbName" Grid.Row="2"
                FontSize="13" Padding="10,7"
                PlaceholderText="Profile name"
                Foreground="{DynamicResource BrTextPrimary}"
                Background="{DynamicResource BrInputBg}"
                BorderBrush="{DynamicResource BrInputBorder}"
                BorderThickness="1"
                CaretBrush="{DynamicResource BrTextPrimary}"
                KeyDown="TbName_KeyDown"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <ui:Button x:Name="BtnCancel" Appearance="Secondary"
                 Content="Cancel" Width="96" Height="30"
                 Margin="0,0,8,0" Click="Cancel_Click"/>
      <ui:Button x:Name="BtnOk" Appearance="Primary"
                 Content="OK" Width="72" Height="30"
                 Click="Ok_Click"/>
    </StackPanel>
  </Grid>
</Window>
