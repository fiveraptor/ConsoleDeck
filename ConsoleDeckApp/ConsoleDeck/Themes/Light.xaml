<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Backgrounds -->
  <SolidColorBrush x:Key="BrPageBg"    Color="#F3F3F3"/>
  <SolidColorBrush x:Key="BrSidebarBg" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="BrCardBg"    Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrFormBg"    Color="#F3F3F3"/>
  <!-- Borders / Dividers -->
  <SolidColorBrush x:Key="BrDivider"    Color="#D9D9D9"/>
  <SolidColorBrush x:Key="BrCardBorder" Color="#E0E0E0"/>
  <!-- Text -->
  <SolidColorBrush x:Key="BrTextPrimary"   Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BrTextSecondary" Color="#5C5C5C"/>
  <SolidColorBrush x:Key="BrTextHint"      Color="#8C8C8C"/>
  <!-- Navigation -->
  <SolidColorBrush x:Key="BrNavHoverBg"    Color="#E0E0E0"/>
  <SolidColorBrush x:Key="BrNavSelectedBg" Color="#CCE4F7"/>
  <SolidColorBrush x:Key="BrNavSelectedFg" Color="#003E92"/>
  <!-- Inputs -->
  <SolidColorBrush x:Key="BrInputBg"     Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrInputBorder" Color="#ABABAB"/>
  <!-- Ghost Button base -->
  <SolidColorBrush x:Key="BrGhostBg"     Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrGhostBorder" Color="#ABABAB"/>
  <!-- Toast -->
  <SolidColorBrush x:Key="BrToastBg" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BrToastFg" Color="#FFFFFF"/>
</ResourceDictionary>
